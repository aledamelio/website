---
import Base from '../layouts/Base.astro';
---

<Base title="Activities — Alessandro D'Amelio" description="Editorial, conference organization, talks, program committees, grants and awards.">
  <div style="padding:28px 0 8px">
    <h1 class="h1">Activities</h1>
  </div>

  <section class="card" style="margin-top:16px">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
      <div class="icon-box">✎</div>
      <h2 class="h2" style="margin:0">Editorial Activities</h2>
    </div>
    <div class="timeline">
      <div class="timeline-item"><div class="timeline-dot"></div><div style="font-weight:650">[2025] — Guest Editor — <em>Frontiers in Artificial Intelligence</em> (Frontiers), Advances in Automatic Affect Analysis and Synthesis.</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div style="font-weight:650">[2023] — Guest Editor — <a href="https://www.sciencedirect.com/journal/biomedical-signal-processing-and-control" target="_blank" rel="noopener"><em>Biomedical Signal Processing and Control</em></a> (Elsevier), Special Issue on Remote Physiological Measurement: Novel algorithms and application areas.</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div style="font-weight:650">[2023 – ...] — Review Editor — Robot Vision and Artificial Perception — <em>Frontiers in Robotics and AI</em> (Frontiers)</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div style="font-weight:650">[2022] — Guest Editor — <em>IEEE Transactions on Emerging Topics in Computing</em>, Special Issue on Emerging Trends and Advances in Graph-based Methods and Applications.</div></div>
    </div>
  </section>

  <section class="card" style="margin-top:14px">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
      <div class="icon-box">◐</div>
      <h2 class="h2" style="margin:0">Conference and Workshop Organization</h2>
    </div>
    <div class="timeline">
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2025] — Track Chair — 40th ACM/SIGAPP Symposium On Applied Computing (SAC 2025). Track on Graph Models for Learning and Recognition (GMLR 2024)</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2025] — Workshop Chair — 4th Automatic Affect Analysis and Synthesis Workshop. In conjunction with the 23rd Int. Conf. on Image Analysis and Processing (ICIAP 2025)</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2023] — Workshop Chair — 1st International Workshop on Advances in Gaze Analysis, Visual attention and Eye-gaze modelling (AGAVE). In conjunction with ICIAP 2023</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2023] — Workshop Chair — 3rd Automatic Affect Analysis and Synthesis Workshop. In conjunction with ICIAP 2023</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2023] — Track Chair — 39th ACM/SIGAPP Symposium On Applied Computing (SAC 2024). Track on Graph Models for Learning and Recognition (GMLR 2024)</div></div>
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2022] — Track Chair — 38th ACM/SIGAPP Symposium On Applied Computing (SAC 2023). Track on Graph Models for Learning and Recognition (GMLR 2023)</div></div>
    </div>
  </section>

  <section class="card" style="margin-top:14px">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
      <div class="icon-box">▸</div>
      <h2 class="h2" style="margin:0">Talks and Seminars</h2>
    </div>
    <div class="timeline">
      <div class="timeline-item"><div class="timeline-dot"></div><div>[2023] — Tutorial Presentation — Remote Physiological Sensing: State of the Art and Applications. In conjunction with ICIAP 2023</div></div>
