---
import Base from '../layouts/Base.astro';
---

<Base title="Teaching — Alessandro D'Amelio" description="Teaching activities at Università degli Studi di Milano and Università Cattolica del Sacro Cuore.">
  <div style="padding:28px 0 8px">
    <h1 class="h1">Teaching</h1>
  </div>

  <section class="card" style="margin-top:16px">
    <div style="display:flex;gap:12px;align-items:center;margin-bottom:12px">
      <div class="icon-box">▤</div>
      <h2 class="h2" style="margin:0">Courses</h2>
    </div>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="kicker">2026 / 27</div>
        <div style="font-weight:700;margin-top:2px">Machine Learning, Neural Networks and Deep Learning</div>
        <div class="muted" style="font-size:0.9rem">Bachelor Degree in Artificial Intelligence — University of Pavia, University of Milano Statale and University of Milano Bicocca</div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="kicker">2022 – presente</div>
        <div style="font-weight:700;margin-top:2px">Laboratorio di Programmazione 1</div>
        <div class="muted" style="font-size:0.9rem">Dipartimento di Informatica — Università degli Studi di Milano · <a href="https://github.com/LabProgrammazione1/Lab_2025-26" target="_blank" rel="noopener">Website</a></div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="kicker">2020 – 2022</div>
        <div style="font-weight:700;margin-top:2px">Coding e fondamenti di Intelligenza Artificiale</div>
        <div class="muted" style="font-size:0.9rem">Laurea Triennale in “Economia e gestione Aziendale”, Dipartimento di Economia — Università Cattolica del Sacro Cuore</div>
      </div>
      <div class="timeline-item">
        <div class="timeline-dot"></div>
        <div class="kicker">2018 / 19</div>
        <div style="font-weight:700;margin-top:2px">Crush Course Computer Science</div>
        <div class="muted" style="font-size:0.9rem">Lauree Magistrali in “Finance and Economics” e “Data Science and Economics” – Dipartimento di Economia, Management e Metodi Quantitativi, Università degli Studi di Milano</div>
      </div>
    </div>
  </section>


</Base>
